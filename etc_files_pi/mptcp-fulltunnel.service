[Unit]
Description=Force all traffic through the MPTCP tunnel (adds 0.0.0.0/1 + 128.0.0.0/1 dev tun0)
Requires=shadowsocks-client.service
After=shadowsocks-client.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Wait up to 5s for tun0 to appear (sslocal recreates it on each start).
ExecStart=/bin/sh -c 'for i in $(seq 20); do ip link show tun0 >/dev/null 2>&1 && break; sleep 0.25; done; ip route add 0.0.0.0/1 dev tun0 2>/dev/null || true; ip route add 128.0.0.0/1 dev tun0 2>/dev/null || true'
ExecStop=/bin/sh -c 'ip route del 0.0.0.0/1 dev tun0 2>/dev/null || true; ip route del 128.0.0.0/1 dev tun0 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
