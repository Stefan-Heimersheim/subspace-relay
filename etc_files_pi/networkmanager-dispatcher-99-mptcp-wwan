#!/bin/bash
# NetworkManager dispatcher for modem uplinks.
# - On `up`: add MPTCP subflow endpoint, source-routing rule, table default
#   route, and a VPS bypass route so sslocal's traffic to the VPS does NOT go
#   through tun0 (would be a routing loop).
# - On `down`/`pre-down`: undo the above.
#
# We do NOT restart shadowsocks-client on `up`: the kernel opens the new
# subflow on the existing MPTCP socket as soon as the endpoint is added,
# so a healthy tunnel does not need to be disturbed. The boot race
# (sslocal coming up before any wwan has an IP) is handled by
# Restart=always on the unit.
#
# A flock around the body serializes concurrent invocations. NetworkManager
# fires events for multiple interfaces in quick succession; without locking,
# route and rule updates can race.

IFACE=$1
ACTION=$2

is_supported_iface() {
  [[ "$1" == wwan* ]] && return 0
  [[ "$1" =~ ^eth[1-8]$ ]] && return 0
  return 1
}

is_supported_iface "$IFACE" || exit 0

LOCK="/run/mptcp-wwan.lock"
exec 9>"$LOCK"
flock 9 || exit 0

IP=$(ip -4 addr show "$IFACE" 2>/dev/null | awk "/inet / {split(\$2,a,\"/\"); print a[1]}")
GW=${IP4_GATEWAY:-}
[ -n "$GW" ] || GW=$(ip route show dev "$IFACE" 2>/dev/null | awk "/default/ {print \$3; exit}")
[ -n "$GW" ] || GW=$(nmcli -g IP4.GATEWAY device show "$IFACE" 2>/dev/null | awk 'NF {print; exit}')
iface_num() {
  case "$1" in
    wwan*) printf '%s\n' "${1#wwan}" ;;
    eth*) printf '%s\n' "${1#eth}" ;;
    *) return 1 ;;
  esac
}

NUM=$(iface_num "$IFACE")
TABLE=$((100 + NUM))
METRIC=$((700 + NUM))
VPS=__VPS_IP__

ensure_vps_bypass_route() {
  local current
  current=$(ip -4 route get "$VPS" 2>/dev/null || true)

  # If sslocal already reaches the VPS through any modem route, leave that
  # route in place. Replacing it during hotplug can briefly disturb the
  # existing MPTCP connection; the new modem can still join via its
  # source-route table.
  if printf '%s\n' "$current" | grep -Eq ' dev (wwan[0-9]+|eth[1-8])'; then
    return 0
  fi

  ip route replace "$VPS" via "$GW" dev "$IFACE" metric "$METRIC" 2>/dev/null || true
}

restore_vps_bypass_route() {
  local candidate_path candidate candidate_table candidate_metric candidate_gw

  for candidate_path in /sys/class/net/wwan* /sys/class/net/eth[1-8]; do
    [ -e "$candidate_path" ] || continue
    candidate=${candidate_path##*/}
    [ "$candidate" = "$IFACE" ] && continue
    candidate_table=$((100 + $(iface_num "$candidate")))
    candidate_metric=$((700 + $(iface_num "$candidate")))
    candidate_gw=$(ip -4 route show table "$candidate_table" default dev "$candidate" 2>/dev/null | awk '/default/ {print $3; exit}')
    [ -n "$candidate_gw" ] || continue

    ip route replace "$VPS" via "$candidate_gw" dev "$candidate" metric "$candidate_metric" 2>/dev/null || true
    return 0
  done
}

# Drop endpoints whose address is no longer configured on their device.
mptcp_gc() {
  local addr id dev
  while read -r addr id dev; do
    [ -n "$id" ] || continue
    ip -4 addr show dev "$dev" 2>/dev/null | grep -qF "inet $addr/" && continue
    ip mptcp endpoint delete id "$id" ||
      logger -t mptcp-wwan "endpoint delete id $id ($addr dev $dev) failed"
  done < <(ip mptcp endpoint show |
    awk '{a=$1;i="";d="";for(n=2;n<=NF;n++){if($n=="id")i=$(n+1);if($n=="dev")d=$(n+1)}print a,i,d}')
}

case "$ACTION" in
  up)
    [[ -z "$IP" || -z "$GW" ]] && exit 0
    while ip rule del table "$TABLE" 2>/dev/null; do : ; done
    ip rule add from "$IP" table "$TABLE" 2>/dev/null || true
    ip route replace default via "$GW" dev "$IFACE" table "$TABLE" 2>/dev/null || true
    mptcp_gc
    ip mptcp endpoint add "$IP" dev "$IFACE" subflow ||
      logger -t mptcp-wwan "endpoint add $IP dev $IFACE failed"
    ensure_vps_bypass_route
    ;;
  down|pre-down)
    mptcp_gc
    while ip rule del table "$TABLE" 2>/dev/null; do : ; done
    ip route del "$VPS" dev "$IFACE" 2>/dev/null || true
    restore_vps_bypass_route
    ;;
esac
