#!/bin/bash
# modem-watchdog: recover an Alcatel stick whose MBIM control channel has hung.
set -u
POLL=${POLL:-20}                  # seconds between checks
GRACE=${GRACE:-60}                # how long a stick may be without an MBIM modem before it is reset (MM needs ~25 s after enumeration, ~45 s when the MBIM probe times out)
COOLDOWN=${COOLDOWN:-300}         # minimum spacing between resets of the same port
REPLUG_AFTER=${REPLUG_AFTER:-2}   # consecutive resets without an MBIM modem before asking for a replug (resets continue at COOLDOWN in case one forces re-enumeration)
VENDOR=1bbb

kmsg() { echo "modem-watchdog: $*"; echo "modem-watchdog: $*" > /dev/kmsg 2>/dev/null || true; }

mm_ports() {   # "<usb port> <mbim|at>" for every modem ModemManager currently has: mbim when its primary port is a cdc-wdm device, at when MM fell back to the serial ports
    local m
    for m in $(mmcli -L 2>/dev/null | grep -oE 'Modem/[0-9]+' | cut -d/ -f2); do
        mmcli -J -m "$m" 2>/dev/null | jq -r '.modem.generic | select(.device != null and .device != "")
            | "\(.device | split("/") | last) \(if (.["primary-port"] // "" | startswith("cdc-wdm")) then "mbim" else "at" end)"'
    done
}

declare -A missing_since last_reset resets
kmsg "started (poll ${POLL}s, grace ${GRACE}s, cooldown ${COOLDOWN}s, replug after ${REPLUG_AFTER} resets)"
while true; do
    known=$(mm_ports)
    now=$(date +%s)
    for d in /sys/bus/usb/devices/*; do
        port=${d##*/}
        [[ $port == *:* ]] && continue                              # an interface, not a device
        [ "$(cat "$d/idVendor" 2>/dev/null)" = "$VENDOR" ] || continue
        kind=$(awk -v p="$port" '$1 == p {print $2; exit}' <<<"$known")
        if [ "$kind" = mbim ]; then unset "missing_since[$port]" "resets[$port]"; continue; fi
        : "${missing_since[$port]:=$now}"
        (( now - missing_since[$port] < GRACE )) && continue
        (( now - ${last_reset[$port]:-0} < COOLDOWN )) && continue
        node=$(printf '%03d/%03d' "$(cat "$d/busnum")" "$(cat "$d/devnum")")   # usbreset's BBB/DDD form
        if [ "$kind" = at ]; then why="ModemManager has only an AT-only modem (MBIM port dead)"; else why="no ModemManager modem"; fi
        kmsg "usbreset $port ($node, $VENDOR:$(cat "$d/idProduct")): $why for $((now - missing_since[$port])) s"
        out=$(usbreset "$node" 2>&1); rc=$?
        [ $rc -eq 0 ] || kmsg "usbreset $port failed (rc $rc): $out"
        last_reset[$port]=$now
        missing_since[$port]=$now
        resets[$port]=$(( ${resets[$port]:-0} + 1 ))
        (( resets[$port] == REPLUG_AFTER )) && kmsg "$port needs a physical replug: still no MBIM modem after ${resets[$port]} usbresets (retrying every ${COOLDOWN}s)"
    done
    sleep "$POLL"
done
